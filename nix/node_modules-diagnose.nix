# Dedicated staged Bun install diagnostics for the Nix node_modules hang.
{
  lib,
  stdenvNoCC,
  bun,
  rev ? "dirty",
}:
let
  packageJson = lib.pipe ../packages/opencode/package.json [
    builtins.readFile
    builtins.fromJSON
  ];
  platform = stdenvNoCC.hostPlatform;
  bunCpu = if platform.isAarch64 then "arm64" else "x64";
  bunOs = if platform.isLinux then "linux" else "darwin";
  mkInstallCommand =
    filters:
    lib.concatStringsSep " \\\n" (
      [
        "bun install"
        "      --cpu=\"${bunCpu}\""
        "      --os=\"${bunOs}\""
      ]
      ++ map (filter: "      --filter \"${filter}\"") filters
      ++ [
        "      --frozen-lockfile"
        "      --ignore-scripts"
        "      --no-progress"
      ]
    );
  opencodeFilters = [
    "!./"
    "./packages/opencode"
  ];
  pluginFilters = opencodeFilters ++ [ "./packages/plugin" ];
  sdkFilters = pluginFilters ++ [ "./packages/sdk/js" ];
  sharedFilters = sdkFilters ++ [ "./packages/shared" ];
  scriptFilters = sharedFilters ++ [ "./packages/script" ];
in
stdenvNoCC.mkDerivation {
  pname = "opencode-node_modules-diagnose";
  version = "${packageJson.version}+${lib.replaceString "-" "." rev}";

  src = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.intersection (lib.fileset.fromSource (lib.sources.cleanSource ../.)) (
      lib.fileset.unions [
        ../packages/opencode
        ../packages/plugin
        ../packages/sdk/js
        ../packages/shared
        ../packages/script
        ../packages/app/package.json
        ../packages/desktop/package.json
        ../packages/desktop-electron/package.json
        ../packages/enterprise/package.json
        ../packages/function/package.json
        ../packages/slack/package.json
        ../packages/storybook/package.json
        ../packages/ui/package.json
        ../packages/web/package.json
        ../packages/console/app/package.json
        ../packages/console/core/package.json
        ../packages/console/function/package.json
        ../packages/console/mail/package.json
        ../packages/console/resource/package.json
        ../bun.lock
        ../package.json
        ../patches
        ../install
        ../.github/TEAM_MEMBERS
      ]
    );
  };

  impureEnvVars = lib.fetchers.proxyImpureEnvVars ++ [
    "GIT_PROXY_COMMAND"
    "SOCKS_SERVER"
  ];

  nativeBuildInputs = [ bun ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild

    copy_workspace() {
      local workspace="$1"
      cp -R ./. "$workspace"
      chmod -R +w "$workspace"
    }

    run_stage() {
      local label="$1"
      local install_command="$2"
      local post_command="$3"
      local workspace
      local cache
      workspace=$(mktemp -d)
      cache=$(mktemp -d)
      echo "=== ''${label}: start ==="
      copy_workspace "$workspace"
      (
        cd "$workspace"
        export BUN_INSTALL_CACHE_DIR="$cache"
        echo "=== ''${label}: bun install start ==="
        eval "$install_command"
        echo "=== ''${label}: bun install done ==="
        if [ -n "$post_command" ]; then
          echo "=== ''${label}: post step start ==="
          eval "$post_command"
          echo "=== ''${label}: post step done ==="
        fi
      )
      echo "=== ''${label}: done ==="
    }

    run_stage "STAGE 1 opencode-only filters" ${lib.escapeShellArg (mkInstallCommand opencodeFilters)} ""
    run_stage "STAGE 2 plugin addition" ${lib.escapeShellArg (mkInstallCommand pluginFilters)} ""
    run_stage "STAGE 3 sdk addition" ${lib.escapeShellArg (mkInstallCommand sdkFilters)} ""
    run_stage "STAGE 4 shared addition" ${lib.escapeShellArg (mkInstallCommand sharedFilters)} ""
    run_stage "STAGE 5 script addition" ${lib.escapeShellArg (mkInstallCommand scriptFilters)} ""
    run_stage "STAGE 6 post-install canonicalize step" ${lib.escapeShellArg (mkInstallCommand scriptFilters)} ${lib.escapeShellArg "bun --bun ${./scripts/canonicalize-node-modules.ts}"}
    run_stage "STAGE 7 post-install normalize step" ${lib.escapeShellArg (mkInstallCommand scriptFilters)} ${
      lib.escapeShellArg (
        lib.concatStringsSep " && " [
          "bun --bun ${./scripts/canonicalize-node-modules.ts}"
          "bun --bun ${./scripts/normalize-bun-binaries.ts}"
        ]
      )
    }

    runHook postBuild
  '';

  installPhase = ''
        runHook preInstall
        mkdir -p "$out"
        cat <<'EOF' > "$out/stages.txt"
    STAGE 1 opencode-only filters
    STAGE 2 plugin addition
    STAGE 3 sdk addition
    STAGE 4 shared addition
    STAGE 5 script addition
    STAGE 6 post-install canonicalize step
    STAGE 7 post-install normalize step
    EOF
        runHook postInstall
  '';

  dontFixup = true;

  meta.platforms = [
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-darwin"
    "x86_64-darwin"
  ];
}
